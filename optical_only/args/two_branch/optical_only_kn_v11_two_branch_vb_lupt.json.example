  "meta_bins_t_span": "0,0.01,0.05,0.1,0.2,0.5,1.0",
  "target_recall": 0.98,
  "early_stop_patience": 20,
  "early_stop_min_delta": 0.01,
  "num_workers": 4,
  "pin_memory": 1,
  "persistent_workers": 0,
  "prefetch_factor": 2,
  "memory_cleanup_enable": 1,
