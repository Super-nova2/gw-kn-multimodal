// Optical-only KN architecture with expanded mTAN encoder details.
// Source of truth: ML+GW+KN/Model/model.py
// Render:
//   dot -Tpng -Gdpi=220 optical_only_architecture_v1_clean.dot -o optical_only_architecture_v1_clean.png
//   dot -Tsvg optical_only_architecture_v1_clean.dot -o optical_only_architecture_v1_clean.svg

digraph G {
  rankdir=TB;
  labelloc=t;
  label="Optical-Only KN Classifier (Expanded Optical Encoder / mTAN)";

  graph [
    fontname="Helvetica",
    fontsize=17,
    bgcolor="#FFFFFF",
    pad=0.2,
    nodesep=0.35,
    ranksep=0.55,
    splines=spline
  ];

  node [
    shape=box,
    style="rounded,filled",
    fontname="Helvetica",
    fontsize=10,
    color="#475569",
    penwidth=1.1
  ];

  edge [color="#64748B", penwidth=1.05, arrowsize=0.7];

  // ---------- Inputs ----------
  subgraph cluster_inputs {
    label="1) Inputs";
    color="#CBD5E1";
    style="rounded,dashed";

    opt_t     [label="opt_t [B,L]\nrelative time", fillcolor="#F8FAFC"];
    opt_ref_t [label="opt_ref_t [B,N]\nreference anchors", fillcolor="#F8FAFC"];
    opt_v     [label="opt_v [B,L,D]\nflux/features", fillcolor="#F8FAFC"];
    opt_mask  [label="opt_mask [B,L,D]\nobs mask", fillcolor="#F8FAFC"];
    opt_err   [label="opt_err [B,L,D]\nmeasurement error", fillcolor="#F8FAFC"];
  }

  offset_shift [label="optional time offset\nopt_t <- opt_t - delta_days/100", fillcolor="#FFFBEB", color="#F59E0B"];
  opt_t -> offset_shift [style=dashed, color="#D97706"];

  // ---------- Encoder ----------
  subgraph cluster_encoder {
    label="2) OpticalEncoderWithCLS";
    color="#86EFAC";
    style="rounded,dashed";

    // Time embedding + CLS query construction
    phi_module [label="LearnablePeriodicEmbedding phi_h(t)\nlinear + sinusoidal terms", fillcolor="#DBEAFE", color="#60A5FA"];
    key_emb    [label="key_emb = phi(t_obs)\n[B,L,H,d_r]", shape=ellipse, fillcolor="#EFF6FF", color="#60A5FA"];
    ref_emb    [label="ref_emb = phi(t_ref)\n[B,N,H,d_r]", shape=ellipse, fillcolor="#EFF6FF", color="#60A5FA"];
    cls_token  [label="learnable cls_token\n[1,1,H,d_r]", fillcolor="#EDE9FE", color="#8B5CF6"];
    cls_add    [label="cls_emb = cls_token (expand B)\n[B,1,H,d_r]", fillcolor="#EDE9FE", color="#8B5CF6"];
    query_cat  [label="query_emb = concat(cls_emb, ref_emb)\n[B,N+1,H,d_r]", fillcolor="#EDE9FE", color="#8B5CF6"];

    // mTAN internals (expanded, but compact)
    qk_proj   [label="Q = W(query), K = V(key)", fillcolor="#FEE2E2", color="#EF4444"];
    score     [label="scores = QK^T / sqrt(d_k)\n[B,H,K,L], K=N+1", fillcolor="#FEE2E2", color="#EF4444"];
    mask_err  [label="expand over D; add error bias\n-lambda*log(sigma^2+eps);\nmask missing -> -1e9", fillcolor="#FEF2F2", color="#EF4444"];
    softmax   [label="softmax over L (per band D)", fillcolor="#FECACA", color="#DC2626"];
    weighted  [label="sum(attn * values) over L\n[B,H,K,D]", fillcolor="#FECACA", color="#DC2626"];
    u_proj    [label="flatten [H*D] + U projection\n[B,K,J]", fillcolor="#FECACA", color="#DC2626"];
    out_drop  [label="output dropout + split", fillcolor="#FECACA", color="#DC2626"];

    z_l [label="z_l [B,J]\nCLS feature", shape=ellipse, fillcolor="#FFF7ED", color="#FB923C"];
    h_l [label="H_l [B,N,J]\ntemporal map", shape=ellipse, fillcolor="#FFF7ED", color="#FB923C"];
  }

  // ---------- Head ----------
  subgraph cluster_head {
    label="3) OpticalKNClassifier Head";
    color="#A5B4FC";
    style="rounded,dashed";

    feat_drop [label="feature dropout\n(on z_l, H_l)", fillcolor="#EEF2FF", color="#6366F1"];
    pool      [label="h_pool = mean(H_l, dim=1)", fillcolor="#E0E7FF", color="#6366F1"];
    concat    [label="concat(z_l, h_pool)\n[B,2J]", fillcolor="#E0E7FF", color="#6366F1"];
    mlp       [label="Linear(2J->hidden) -> ReLU\n-> Dropout -> Linear(hidden->1)", fillcolor="#E0E7FF", color="#6366F1"];
    logits    [label="logit [B,1]\n(BCEWithLogitsLoss)", shape=diamond, style=filled, fillcolor="#FEE2E2", color="#EF4444", fontcolor="#991B1B"];
  }

  hp_note [label="Typical v4: D=6, H=4, N=64,\nd_r=64, d_k=64, J=128, hidden=64", shape=note, fillcolor="#FFFBEB", color="#D97706", fontsize=9];

  // Wiring: inputs
  offset_shift -> phi_module;
  opt_t -> phi_module [style=dashed, label="or direct t_obs", color="#0EA5E9"];
  opt_ref_t -> phi_module;
  opt_v -> weighted;
  opt_mask -> mask_err;
  opt_err -> mask_err;

  // Wiring: encoder
  phi_module -> key_emb;
  phi_module -> ref_emb;
  cls_token -> cls_add;
  cls_add -> query_cat;
  ref_emb -> query_cat;

  query_cat -> qk_proj;
  key_emb -> qk_proj;
  qk_proj -> score -> mask_err -> softmax -> weighted -> u_proj -> out_drop;
  out_drop -> z_l;
  out_drop -> h_l;

  // Wiring: head
  z_l -> feat_drop;
  h_l -> feat_drop;
  feat_drop -> pool;
  feat_drop -> concat;
  pool -> concat -> mlp -> logits;
  logits -> hp_note [style=dotted, arrowhead=none, color="#F59E0B"];
}
