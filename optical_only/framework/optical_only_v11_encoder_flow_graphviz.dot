// Optical-only v11 two-branch encoder flow
digraph G {
	label="Optical-only v11 Encoder Flow (two_branch_vb_lupt, precomputed_h5)" labelloc=t rankdir=LR
	graph [bgcolor="#FFFFFF" dpi=220 fontname=Helvetica fontsize=18 nodesep=0.42 pad=0.12 ranksep=0.78 splines=spline]
	node [color="#475569" fontname=Helvetica fontsize=11 penwidth=1.2 shape=box style="rounded,filled"]
	edge [arrowsize=0.75 color="#64748B" penwidth=1.2]
	subgraph cluster_inputs {
		color="#CBD5E1" label="1) Inputs" style="rounded,dashed"
		opt_t [label="opt_t\n(time)" color="#38BDF8" fillcolor="#F0F9FF"]
		opt_v [label="opt_v\n(luptitude)" color="#38BDF8" fillcolor="#F0F9FF"]
		opt_mask [label=opt_mask color="#38BDF8" fillcolor="#F0F9FF"]
		opt_err [label=opt_err color="#38BDF8" fillcolor="#F0F9FF"]
		slot_det [label=slot_is_detection color="#38BDF8" fillcolor="#F0F9FF"]
		precache [label="two_branch_* cache from H5\n(band_idx, det/ul static, conf, mask)" color="#38BDF8" fillcolor="#F0F9FF"]
	}
	subgraph cluster_prep {
		color="#FDE68A" label="2) Two-branch feature prep" style="rounded,dashed"
		prep [label="Prefer precomputed_h5 cache\nElse derive runtime from\nlupt + sigma + detection label" color="#F59E0B" fillcolor="#FEF3C7"]
		ref_time [label="Reference time grid" color="#F59E0B" fillcolor="#FEF3C7"]
		time_emb [label="Learnable time embedding" color="#22C55E" fillcolor="#DCFCE7"]
		band_emb [label="Band embedding" color="#22C55E" fillcolor="#DCFCE7"]
	}
	subgraph cluster_encoder {
		color="#FCA5A5" label="3) Two-branch optical encoder" style="rounded,dashed"
		det_branch [label="DET branch attention\n+ det_cls_token" color="#EF4444" fillcolor="#FEE2E2"]
		ul_branch [label="UL branch attention\n+ ul_cls_token" color="#EF4444" fillcolor="#FEE2E2"]
		fuse [label="Branch fuse + norm" color="#8B5CF6" fillcolor="#EDE9FE"]
		z_l [label="z_l\nCLS/global feature" color="#FB923C" fillcolor="#FFF7ED" shape=ellipse]
		H_l [label="H_l\nTemporal token sequence" color="#FB923C" fillcolor="#FFF7ED" shape=ellipse]
	}
	subgraph cluster_heads {
		color="#93C5FD" label="4) Heads" style="rounded,dashed"
		pool [label="Temporal mean pool(H_l)" color="#3B82F6" fillcolor="#DBEAFE"]
		concat [label="concat[z_l, h_pool]" color="#3B82F6" fillcolor="#DBEAFE"]
		clf [label="Main classifier MLP\nlogit -> prob" color="#3B82F6" fillcolor="#DBEAFE"]
		proj [label="Projection head\n(universal train)" color="#3B82F6" fillcolor="#DBEAFE"]
		adv [label="GRL + adv heads\n(n_det / n_bands / t_span)" color="#3B82F6" fillcolor="#DBEAFE"]
	}
	subgraph cluster_infer {
		color="#D1D5DB" label="5) Inference wrapper" style="rounded,dashed"
		offset [label="Time-offset ensemble\n(quantile offsets from delta_days_distribution)" color="#9CA3AF" fillcolor="#F3F4F6"]
		rank [label="Average logits across offsets\nRank candidates / export artifacts" color="#9CA3AF" fillcolor="#F3F4F6"]
	}
	opt_t -> prep
	opt_v -> prep
	opt_mask -> prep
	opt_err -> prep
	slot_det -> prep
	precache -> prep [label="if exists" style=dashed]
	ref_time -> time_emb
	prep -> band_emb
	prep -> det_branch
	prep -> ul_branch
	time_emb -> det_branch
	time_emb -> ul_branch
	band_emb -> det_branch
	band_emb -> ul_branch
	det_branch -> fuse
	ul_branch -> fuse
	fuse -> z_l
	fuse -> H_l
	H_l -> pool
	z_l -> concat
	pool -> concat
	concat -> clf
	concat -> proj [style=dashed]
	concat -> adv [style=dashed]
	clf -> offset
	offset -> rank
}
