// Optical-Only KN Classifier — full architecture with adversarial training.
// Render:
//   dot -Tpng -Gdpi=240 optical_only_architecture_adv.dot -o optical_only_architecture_adv.png
//   dot -Tsvg optical_only_architecture_adv.dot -o optical_only_architecture_adv.svg
//   dot -Tpdf optical_only_architecture_adv.dot -o optical_only_architecture_adv.pdf

digraph OpticalOnlyAdv {
  rankdir=TB;
  newrank=true;
  labelloc=t;
  label=<<B>Optical-Only KN Classifier with Adversarial Training</B>>;

  graph [
    bgcolor="#FAFBFC",
    fontname="Droid Sans Fallback",
    fontsize=16,
    pad=0.4,
    nodesep=0.45,
    ranksep=0.55,
    splines=ortho,
    compound=true,
  ];

  node [
    shape=box,
    style="rounded,filled",
    fontname="Droid Sans Fallback",
    fontsize=10,
    penwidth=1.2,
    margin="0.12,0.08",
  ];

  edge [
    color="#64748B",
    penwidth=1.2,
    arrowsize=0.7,
  ];

  // ═══════════════════════════════════════════════════════════════════
  //  INPUT
  // ═══════════════════════════════════════════════════════════════════
  subgraph cluster_input {
    label="";
    style=invis;

    input [
      label=<Optical Observations<BR/><FONT POINT-SIZE="8.5">(t, v, mask, err)  [B, L, 6 bands]</FONT>>,
      fillcolor="#DBEAFE", color="#2563EB",
    ];

    reftime [
      label=<Reference Time Grid<BR/><FONT POINT-SIZE="8.5">t<SUB>ref</SUB>  [B, N=64]</FONT>>,
      fillcolor="#DBEAFE", color="#2563EB",
    ];
  }

  // ═══════════════════════════════════════════════════════════════════
  //  ENCODER
  // ═══════════════════════════════════════════════════════════════════
  subgraph cluster_encoder {
    label=<<B>Optical Encoder</B>>;
    labelloc=t;
    style="rounded,dashed";
    color="#059669";
    fontcolor="#059669";
    fontsize=11;
    fillcolor="#F0FDF4";

    time_embed [
      label=<Learnable Periodic Embedding<BR/><FONT POINT-SIZE="8.5">&phi;<SUB>h</SUB>(t) = {w<SUB>0</SUB>t, sin(w<SUB>i</SUB>t+a<SUB>i</SUB>)}  [B, *, H=4, d=64]</FONT>>,
      fillcolor="#D1FAE5", color="#059669",
    ];

    cls_token [
      label=<[CLS] Token<BR/><FONT POINT-SIZE="8.5">learnable  [1, 1, H, d]</FONT>>,
      fillcolor="#D1FAE5", color="#059669",
    ];

    mtan [
      label=<Multi-Time Attention (mTAN)<BR/><FONT POINT-SIZE="8.5">per-band masking + SNR weighting  &rarr; [B, N+1, J=128]</FONT>>,
      fillcolor="#EDE9FE", color="#7C3AED",
    ];
  }

  // ═══════════════════════════════════════════════════════════════════
  //  FEATURE FUSION
  // ═══════════════════════════════════════════════════════════════════
  cls_vec [
    label=<CLS vector  z  [B, 128]>,
    fillcolor="#FEF9C3", color="#CA8A04",
  ];

  temp_pool [
    label=<Temporal mean pooling  h&#772;  [B, 128]>,
    fillcolor="#FEF9C3", color="#CA8A04",
  ];

  concat [
    label=<Concat  [z ; h&#772;]  [B, 256]>,
    fillcolor="#F3E8FF", color="#9333EA",
  ];

  // ═══════════════════════════════════════════════════════════════════
  //  CLASSIFICATION HEAD  (Stage 1+)
  // ═══════════════════════════════════════════════════════════════════
  subgraph cluster_cls {
    label=<<FONT POINT-SIZE="9" COLOR="#DB2777"><B>  Stage 1-3: Classification  </B></FONT>>;
    style="rounded,dashed";
    color="#DB2777";
    fillcolor="#FFF1F2";

    cls_head [
      label=<Classification Head (MLP)<BR/><FONT POINT-SIZE="8.5">256 &rarr; 128 &rarr; 1,  ReLU + Dropout</FONT>>,
      fillcolor="#FCE7F3", color="#DB2777",
    ];

    output [
      label=<KN Score<BR/><FONT POINT-SIZE="8.5">p = &sigma;(logit)</FONT>>,
      shape=ellipse,
      fillcolor="#FEE2E2", color="#DC2626",
    ];
  }

  // ═══════════════════════════════════════════════════════════════════
  //  CONSISTENCY (Stage 2+)
  // ═══════════════════════════════════════════════════════════════════
  subgraph cluster_consistency {
    label=<<FONT POINT-SIZE="9" COLOR="#0D9488"><B>  Stage 2-3: Dual-View Consistency  </B></FONT>>;
    style="rounded,dashed";
    color="#0D9488";
    fillcolor="#F0FDFA";

    proj_head [
      label=<Projection Head (MLP)<BR/><FONT POINT-SIZE="8.5">256 &rarr; 128 &rarr; 64, &#x2113;<SUB>2</SUB>-norm</FONT>>,
      fillcolor="#CCFBF1", color="#0D9488",
    ];

    loss_cons [
      label=<L<SUB>cons</SUB><BR/><FONT POINT-SIZE="8.5">cosine sim + symmetric KL</FONT>>,
      shape=cds,
      fillcolor="#CCFBF1", color="#0D9488",
    ];
  }

  // ═══════════════════════════════════════════════════════════════════
  //  ADVERSARIAL BRANCH  (Stage 3)
  // ═══════════════════════════════════════════════════════════════════
  subgraph cluster_adv {
    label=<<FONT POINT-SIZE="9" COLOR="#C2410C"><B>  Stage 3: Gradient-Reversal Adversarial Training  </B></FONT>>;
    style="rounded,dashed";
    color="#C2410C";
    fillcolor="#FFF7ED";

    grl [
      label=<Gradient Reversal Layer<BR/><FONT POINT-SIZE="8.5">forward: identity  |  backward: &minus;&lambda;<SUB>GRL</SUB> &nabla;</FONT>>,
      fillcolor="#FEF3C7", color="#D97706",
    ];

    adv_det [
      label=<Adv Head: N<SUB>det</SUB><BR/><FONT POINT-SIZE="8.5">5 classes</FONT>>,
      fillcolor="#FFEDD5", color="#EA580C",
    ];

    adv_band [
      label=<Adv Head: N<SUB>bands</SUB><BR/><FONT POINT-SIZE="8.5">4 classes</FONT>>,
      fillcolor="#FFEDD5", color="#EA580C",
    ];

    adv_span [
      label=<Adv Head: &Delta;t<BR/><FONT POINT-SIZE="8.5">5 classes</FONT>>,
      fillcolor="#FFEDD5", color="#EA580C",
    ];

    loss_adv [
      label=<L<SUB>adv</SUB><BR/><FONT POINT-SIZE="8.5">CE &times; 3 (reversed grad)</FONT>>,
      shape=cds,
      fillcolor="#FFEDD5", color="#EA580C",
    ];
  }

  // ═══════════════════════════════════════════════════════════════════
  //  LOSS BOX
  // ═══════════════════════════════════════════════════════════════════
  loss_cls [
    label=<L<SUB>cls</SUB><BR/><FONT POINT-SIZE="8.5">BCE</FONT>>,
    shape=cds,
    fillcolor="#FCE7F3", color="#DB2777",
  ];

  total_loss [
    label=<Total Loss<BR/><FONT POINT-SIZE="8.5">L = L<SUB>cls</SUB> + &lambda;<SUB>emb</SUB>L<SUB>emb</SUB> + &lambda;<SUB>prob</SUB>L<SUB>prob</SUB> + &lambda;<SUB>det</SUB>L<SUB>det</SUB> + &lambda;<SUB>band</SUB>L<SUB>band</SUB> + &lambda;<SUB>span</SUB>L<SUB>span</SUB></FONT>>,
    fillcolor="#F1F5F9", color="#334155",
    shape=box,
    style="rounded,filled,bold",
    fontsize=10,
  ];

  // ═══════════════════════════════════════════════════════════════════
  //  EDGES — main path
  // ═══════════════════════════════════════════════════════════════════
  input   -> time_embed;
  reftime -> time_embed;
  time_embed -> mtan;
  cls_token  -> mtan;

  mtan -> cls_vec    [label="  CLS"];
  mtan -> temp_pool  [label="  temporal"];

  cls_vec   -> concat;
  temp_pool -> concat;

  concat -> cls_head;
  cls_head -> output;
  output -> loss_cls;

  // ═══════════════════════════════════════════════════════════════════
  //  EDGES — consistency
  // ═══════════════════════════════════════════════════════════════════
  concat -> proj_head [color="#0D9488", style=dashed];
  proj_head -> loss_cons [color="#0D9488"];

  // ═══════════════════════════════════════════════════════════════════
  //  EDGES — adversarial
  // ═══════════════════════════════════════════════════════════════════
  concat -> grl [color="#C2410C", style=dashed];
  grl -> adv_det  [color="#EA580C"];
  grl -> adv_band [color="#EA580C"];
  grl -> adv_span [color="#EA580C"];
  adv_det  -> loss_adv [color="#EA580C"];
  adv_band -> loss_adv [color="#EA580C"];
  adv_span -> loss_adv [color="#EA580C"];

  // ═══════════════════════════════════════════════════════════════════
  //  EDGES — losses → total
  // ═══════════════════════════════════════════════════════════════════
  loss_cls  -> total_loss [style=dashed, color="#94A3B8"];
  loss_cons -> total_loss [style=dashed, color="#94A3B8"];
  loss_adv  -> total_loss [style=dashed, color="#94A3B8"];

  // ═══════════════════════════════════════════════════════════════════
  //  LAYOUT HINTS
  // ═══════════════════════════════════════════════════════════════════
  { rank=same; input; reftime; }
  { rank=same; cls_vec; temp_pool; }
  { rank=same; adv_det; adv_band; adv_span; }
  { rank=same; loss_cls; loss_cons; loss_adv; }
}
