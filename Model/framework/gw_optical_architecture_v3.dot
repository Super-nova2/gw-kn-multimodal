# Graphviz DOT (v3, clean & compact)
# Render examples:
#   dot -Tpng gw_optical_architecture_optimized_v3.dot -o gw_optical_architecture_optimized_v3.png
#   dot -Tsvg gw_optical_architecture_optimized_v3.dot -o gw_optical_architecture_optimized_v3.svg
#   dot -Tpdf gw_optical_architecture_optimized_v3.dot -o gw_optical_architecture_optimized_v3.pdf


digraph G {
  rankdir=LR;
  graph [fontname="Helvetica", fontsize=12, bgcolor="white", splines=true, nodesep=0.35, ranksep=0.6, margin=0.05];
  node  [fontname="Helvetica", fontsize=11, shape=box, style="rounded,filled", color="#4B5563", penwidth=1.0];
  edge  [color="#6B7280", arrowsize=0.7, penwidth=1.0];

  // ===== Inputs =====
  subgraph cluster_in {
    label="Inputs";
    color="#D1D5DB";
    style="rounded,dashed";

    subgraph cluster_in_gw {
      label="GW";
      color="#E5E7EB";
      style="rounded";

      gw_scalars [label="GW scalars", fillcolor="#F3F4F6"];
      gw_skymap  [label="GW skymap\n(HEALPix/MOC)", fillcolor="#F3F4F6"];
    }

    subgraph cluster_in_opt {
      label="Optical";
      color="#E5E7EB";
      style="rounded";

      opt_lc     [label="Light curves", fillcolor="#F3F4F6"];
      time_ref   [label="Time anchors", fillcolor="#F3F4F6"];
      cls_tok    [label="Learnable [CLS]", fillcolor="#F3F4F6"];
      opt_coords [label="Coords (RA, Dec)", fillcolor="#F3F4F6"];
    }
  }

  // ===== Encoders =====
  subgraph cluster_gw {
    label="GW encoder";
    color="#93C5FD";
    style="rounded,dashed";

    gw_enc [label="Dual-stream encoder\n(MLP + CNN/ResNet)", fillcolor="#DBEAFE", color="#60A5FA"];
    gw_g [label="g", fillcolor="#FFEDD5", color="#FB923C"];
    gw_H [label="H_gw", fillcolor="#FFEDD5", color="#FB923C"];
  }

  subgraph cluster_opt {
    label="Optical encoder";
    color="#86EFAC";
    style="rounded,dashed";

    opt_enc [label="Temporal encoder\n(mTAN/Transformer + CLS)\n+ RA/Dec embedding", fillcolor="#DCFCE7", color="#22C55E"];
    opt_z [label="z_I", fillcolor="#FFEDD5", color="#FB923C"];
    opt_H [label="H_I", fillcolor="#FFEDD5", color="#FB923C"];
  }

  // ===== Alignment (Contrastive) =====
  subgraph cluster_align {
    label="Alignment (contrastive)";
    color="#A5B4FC";
    style="rounded,dashed";

    proj [label="Projection heads", fillcolor="#E0E7FF", color="#6366F1"];
    itc_loss [shape=diamond, label="L_itc", style="filled", fillcolor="#FEE2E2", color="#EF4444", fontcolor="#991B1B"];
  }

  // ===== Fusion + Classification =====
  subgraph cluster_fusion {
    label="Fusion + classification";
    color="#FCA5A5";
    style="rounded,dashed";

    dual_attn [label="Dual cross-attn\n(GW <-> Opt)", fillcolor="#FEF3C7", color="#F59E0B"];
    cred   [label="Credibility\n(skymap + coords)", fillcolor="#FEF3C7", color="#F59E0B"];
    concat [label="Concat", fillcolor="#FEF3C7", color="#F59E0B"];
    clf    [label="Classifier (MLP)", fillcolor="#FEF3C7", color="#F59E0B"];
    cls_loss [shape=diamond, label="L_cls", style="filled", fillcolor="#FEE2E2", color="#EF4444", fontcolor="#991B1B"];
  }

  // ===== Wiring =====
  gw_scalars -> gw_enc;
  gw_skymap  -> gw_enc;
  gw_enc -> gw_g;
  gw_enc -> gw_H;

  opt_lc     -> opt_enc;
  time_ref   -> opt_enc;
  cls_tok    -> opt_enc;
  opt_coords -> opt_enc;
  opt_enc -> opt_z;
  opt_enc -> opt_H;

  // Alignment
  gw_g  -> proj;
  opt_z -> proj;
  proj -> itc_loss;

  // Fusion
  gw_g  -> dual_attn;
  gw_H  -> dual_attn;
  opt_z -> dual_attn;
  opt_H -> dual_attn;
  dual_attn -> concat;

  gw_skymap  -> cred;
  opt_coords -> cred;
  cred -> concat;

  concat -> clf -> cls_loss;
}
