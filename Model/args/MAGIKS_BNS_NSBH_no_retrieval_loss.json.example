{
  "data_path": "<BASE_DIR>/data/ALBEF_dataset/combined_dataset_train.h5",
  "neg_data_path": "<BASE_DIR>/data/Optical_Negative_dataset/ELASTICC2_negative_dataset.h5",
  "neg_group": "ELASTICC2/optical_data",
  "epochs": 100,
  "batch_size": 1024,
  "steps_per_epoch": 100,
  "ckpt_path": "<BASE_DIR>/data/model/checkpoints_bns_nsbh/bns_nsbh_ablation_no_retrieval_loss",
  "stage_to_jobfs": true,
  "cache_in_memory": true,
  "val_split": 0.2,
  "val_batch_size": 1024,
  "val_steps_per_epoch": 16,
  "early_stop_patience": 20,
  "early_stop_min_delta": 0.01,
  "resume": null,
  "lr": 0.0005,
  "lr_scheduler": "cosine",
  "weight_decay": 0.02,
  "grad_clip_norm": 1.0,
  "warmup_epochs": 5,
  "min_lr": 2e-05,
  "gallery_loss_weight": 0.0,
  "gallery_distractor_time_mode": "synthetic_after_gw",
  "gallery_distractor_time_window_days": 30.0,
  "itc_weight": 1.0,
  "cls_weight": 1.0,
  "fusion_mode": "physical_dual_hgw",
  "max_gallery_queries": 64,
  "use_time_delta_cls_feature": true,
  "time_delta_cls_scale_days": 30.0,
  "time_delta_cls_clip": 10.0,
  "time_compat_weight": 0.6,
  "gallery_hard_neg_enable": false,
  "gallery_hard_neg_start_after_retrieval_epochs": 10,
  "gallery_hard_neg_ramp_epochs": 0
}
