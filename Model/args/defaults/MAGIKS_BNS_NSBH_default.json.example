  "mtan_snr_clip_min": -8.0,
  "mtan_snr_clip_max": 20.0,
  "mtan_snr_eps": 1e-09,
  "mtan_lupt_psfflux_zp": 31.4,
  "mtan_lupt_k": 1.0,
  "mtan_lupt_m5_mag": "23.9,25.0,24.7,24.0,23.3,22.1",
  "itc_loss_type": "supcon",
  "supcon_margin": 0.0,
  "samples_per_gw": 4,
  "min_lc_per_gw": 2,
  "itc_weight": 1.0,
  "cls_weight": 1.0,
  "cls_pos_weight": 1.0,
  "cls_neg_weight": 1.0,
