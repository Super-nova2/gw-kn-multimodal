  "val_batch_size": 1024,
  "val_steps_per_epoch": 25,
  "validation_gallery_enable": true,
  "validation_gallery_mode": "synthetic_time_sky_hard",
  "validation_gallery_sizes": [
    100,
    500,
    1000
  ],
  "validation_gallery_queries_per_source": 64,
