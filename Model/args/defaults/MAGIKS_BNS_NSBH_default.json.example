  "validation_gallery_recall_at_1_weight": 0.2,
  "early_stop_patience": 20,
  "early_stop_min_delta": 0.01,
  "best_ckpt_metric": "hard_gallery_macro_retrieval_score",
  "best_ckpt_start_epoch": null,
  "resume": null,
  "lr": 0.0005,
  "lr_scheduler": "cosine",
  "weight_decay": 0.02,
  "grad_clip_norm": 1.0,
  "warmup_epochs": 5,
  "min_lr": 2e-05,
  "ref_start": -0.1,
  "ref_end": 0.2,
  "n_ref": 64,
  "ref_dim": 64,
  "enc_dim": 128,
  "proj_dim": 128,
  "optical_curve_dim": 192,
  "optical_coord_dim": 64,
  "optical_curve_hidden_dim": 256,
