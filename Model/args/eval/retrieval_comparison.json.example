{
  "models": [
    {
      "name": "Skymap-only",
      "type": "skymap"
    },
    {
      "name": "Optical-only baseline",
      "type": "optical",
      "checkpoint": "<BASE_DIR>/data/model/checkpoints_optical/optical_only/optical_only_kn_baseline",
      "config": "<REPO_ROOT>/optical_only/args/optical_only_kn_baseline.json"
    },
    {
      "name": "Fink Random Forest",
      "type": "fink_rf",
      "checkpoint": "<BASE_DIR>/fink-rf-reproduction/outputs/fink_rf_ugrizY_fair_albef_elasticc2/model.joblib"
    },
    {
      "name": "Full",
      "type": "multimodal",
      "checkpoint": "<BASE_DIR>/data/model/checkpoints_bns_nsbh/bns_nsbh_full",
      "config": "<REPO_ROOT>/Model/args/MAGIKS_BNS_NSBH_full.json"
    },
    {
      "name": "w/o Hard Mining",
      "type": "multimodal",
      "checkpoint": "<BASE_DIR>/data/model/checkpoints_bns_nsbh/bns_nsbh_no_hard_mining_hpo_v7_mixed_gallery",
      "config": "<REPO_ROOT>/Model/args/MAGIKS_BNS_NSBH_no_hard_mining.json"
    },
    {
      "name": "w/o Contrastive Loss",
      "type": "multimodal",
      "checkpoint": "<BASE_DIR>/data/model/checkpoints_bns_nsbh/bns_nsbh_ablation_no_itc_loss",
      "config": "<REPO_ROOT>/Model/args/MAGIKS_BNS_NSBH_no_itc_loss.json"
    },
    {
      "name": "w/o Retrieval Loss",
      "type": "multimodal",
      "checkpoint": "<BASE_DIR>/data/model/checkpoints_bns_nsbh/bns_nsbh_ablation_no_retrieval_loss",
      "config": "<REPO_ROOT>/Model/args/MAGIKS_BNS_NSBH_no_retrieval_loss.json"
    },
    {
      "name": "w/o Classification Loss",
      "type": "multimodal",
      "checkpoint": "<BASE_DIR>/data/model/checkpoints_bns_nsbh/bns_nsbh_ablation_no_cls_loss",
      "config": "<REPO_ROOT>/Model/args/MAGIKS_BNS_NSBH_no_cls_loss.json"
    },
    {
      "name": "w/o Cross-Attn",
      "type": "multimodal",
      "checkpoint": "<BASE_DIR>/data/model/checkpoints_bns_nsbh/bns_nsbh_ablation_no_cross_atten",
      "config": "<REPO_ROOT>/Model/args/MAGIKS_BNS_NSBH_no_cross_atten.json"
    },
    {
      "name": "w/o Fusion",
      "type": "multimodal",
      "scoring": "contrastive",
      "checkpoint": "<BASE_DIR>/data/model/checkpoints_bns_nsbh/bns_nsbh_ablation_no_fusion",
      "config": "<REPO_ROOT>/Model/args/MAGIKS_BNS_NSBH_no_fusion.json"
    }
  ],
  "test_data_path": "<BASE_DIR>/data/ALBEF_dataset/combined_dataset_astro_test.h5",
  "neg_data_path": "<BASE_DIR>/data/Optical_Negative_dataset/ELASTICC_negative_dataset.h5",
  "neg_group": "ELASTICC/optical_data",
  "output_dir": "<REPO_ROOT>/Model/eval_results/retrieval_comparison",
  "positive_selection": "random",
  "gallery_sizes": "10,100,500,1000,2000,5000",
  "gallery_trials": 10,
  "gallery_candidate_mode": "synthetic_time_sky_hard",
  "gallery_candidate_time_window_days": 30.0,
  "gallery_candidate_credible_level_max": 0.9,
  "gallery_include_undersized": true,
  "n_neg_samples": 500000,
  "test_steps": 20,
  "seed": 42,
  "batch_size": 512,
  "num_workers": 2,
  "device": "cuda",
  "amp_dtype": "bf16",
  "opt_n_ref": 64,
  "opt_ref_start": -0.1,
  "opt_ref_end": 0.2,
  "tutorial_neg_data_path": "<BASE_DIR>/data/Optical_Only_dataset/Tutorial_negative_dataset.h5",
  "tutorial_neg_group": "Tutorial/optical_data",
  "force_tutorial_distractors": false,
  "nonkn_cls_base_field": "zero_time_mjd_cls_base",
  "hard_negative_strategy": "simple",
  "stage_to_jobfs": true,
  "redshift_analysis_enable": true,
  "redshift_catalogs": {
    "bns": "<BASE_DIR>/GWSamplegen/outputs/production_rubin_dual/bns_test_seed_42/pos_catalog.csv",
    "nsbh": "<BASE_DIR>/GWSamplegen/outputs/production_rubin_dual/nsbh_test_seed_42/pos_catalog.csv"
  },
  "redshift_bin_edges": [
    0.0,
    0.04,
    0.065,
    0.1,
    0.14,
    0.2
  ],
  "redshift_bin_labels": [
    "0.01-0.03",
    "0.05",
    "0.08",
    "0.12",
    "0.16"
  ]
}
