    "ref_dim": 64,
    "enc_dim": 128,
    "proj_dim": 256,
    "fusion_attn_dim": null,
    "fusion_hidden_dim": null,
    "fusion_dropout": 0.2,
    "temp_init": 0.07,
    "temp_final": 0.07,
    "temp_min": 0.01,
    "temp_max": 0.5,
    "temp_schedule": "learned",
    "mtan_snr_s0": 3.0,
    "mtan_snr_beta": 1.0,
    "mtan_snr_clip_min": -8.0,
    "mtan_snr_clip_max": 20.0,
