    "time_compat_power": 2.0,
    "time_compat_max_penalty": 8.0,
    "nonkn_cls_base_field": "zero_time_mjd_cls_base",
    "gw_dropout": 0.1,
    "opt_dropout": 0.1,
    "proj_dropout": 0.1,
    "itc_loss_type": "supcon",
    "supcon_margin": 0.0,
    "samples_per_gw": 4,
    "min_lc_per_gw": 2,
    "itc_weight": 2.0,
    "cls_weight": 1.0,
    "cls_pos_weight": 1.0,
