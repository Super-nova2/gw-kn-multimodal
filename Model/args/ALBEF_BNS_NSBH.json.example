    "stage_to_jobfs": true,
    "cache_in_memory": true,
    "val_split": 0.2,
    "val_batch_size": 1024,
    "val_steps_per_epoch": 25,
    "split_seed": 42,
    "early_stop_patience": 20,
    "early_stop_min_delta": 0.01,
    "best_ckpt_metric": "cls_composite_auprc_auroc",
    "resume": null,
    "lr": 0.0005,
    "lr_scheduler": "cosine",
    "weight_decay": 0.02,
    "grad_clip_norm": 1.0,
    "label_smoothing": 0.1,
    "warmup_epochs": 5,
    "min_lr": 0.00002,
    "num_workers": 4,
    "pin_memory": 1,
    "persistent_workers": 1,
    "prefetch_factor": 4,
    "n_ref": 64,
