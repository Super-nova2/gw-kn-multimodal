    "mtan_lupt_psfflux_zp": 31.4,
    "mtan_lupt_k": 1.0,
    "mtan_lupt_m5_mag": "23.9,25.0,24.7,24.0,23.3,22.1",
    "time_compat_weight": 0.6,
