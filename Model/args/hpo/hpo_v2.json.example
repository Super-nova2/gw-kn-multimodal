{
  "study_name": "albef_hpo_composite_bns_nsbh_v2",
  "n_trials": 50,
  "n_startup_trials": 10,
  "epochs_per_trial": 30,
  "output_dir": "<BASE_DIR>/data/model/hpo_results_bns_nsbh_v2",
  "base_train_config": "<BASE_DIR>/ML+GW+KN/Model/args/ALBEF_BNS_NSBH.json",
  "objective_metric": "combined_auroc_g2o_r5",
  "objective_direction": "maximize",
  "data_path": "<BASE_DIR>/data/ALBEF_dataset/combined_dataset_train.h5",
  "neg_data_path": "<BASE_DIR>/data/Optical_Only_dataset/ELASTICC2_negative_dataset.h5",
  "neg_group": "ELASTICC2/optical_data",
  "num_workers": 4,
  "cache_in_memory": false,
  "tunable_params": [
    "lr",
    "weight_decay",
    "warmup_epochs",
    "enc_dim",
    "proj_dim",
    "ref_shared_dim",
    "cls_start_epoch",
    "time_compat_weight",
    "semi_hard_margin",
    "hardneg_min_candidates",
    "augment_enable"
  ],
  "fixed_overrides": {
    "semi_hard": true
  },
  "search_space": {
    "lr": {"type": "float", "low": 0.0002, "high": 0.0008, "log": true},
    "weight_decay": {"type": "float", "low": 0.005, "high": 0.05, "log": true},
    "warmup_epochs": {"type": "categorical", "choices": [2, 3, 5, 7, 10]},
    "enc_dim": {"type": "categorical", "choices": [64, 96, 128, 160]},
    "proj_dim": {"type": "categorical", "choices": [128, 192, 256, 320]},
    "ref_shared_dim": {"type": "categorical", "choices": [32, 64, 96]},
    "cls_start_epoch": {"type": "categorical", "choices": [5, 10, 15]},
    "time_compat_weight": {"type": "float", "low": 0.3, "high": 1.0},
    "semi_hard_margin": {"type": "float", "low": 0.1, "high": 0.35},
    "hardneg_min_candidates": {"type": "categorical", "choices": [2, 4, 6, 8]},
    "augment_enable": {"type": "categorical", "choices": [true, false]}
  },
  "constraints": {
    "hard_neg_start_epoch": "cls_start_epoch + 5",
    "cls_ramp_epochs": 5,
    "hard_neg_ramp_epochs": 5
  }
}
