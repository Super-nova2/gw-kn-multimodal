{
  "study_name": "magiks_hpo_v6_main_guardrail85",
  "n_trials": 30,
  "n_startup_trials": 8,
  "epochs_per_trial": 30,
  "output_dir": "<BASE_DIR>/data/model/hpo_results_bns_nsbh_v6_main_guardrail85",
  "default_train_config": "<REPO_ROOT>/Model/args/defaults/MAGIKS_BNS_NSBH_default.json",
  "base_train_config": "<REPO_ROOT>/Model/args/MAGIKS_BNS_NSBH_full.json",
  "best_ckpt_metric": "hard_gallery_macro_retrieval_score",
  "objective_metric": "hard_gallery_macro_retrieval",
  "objective_direction": "maximize",
  "objective_weights": {
    "val_hard_gallery_macro_retrieval_score": 1.0
  },
  "objective_min_metrics": {
    "val_neg_gw_min_recall": 0.85
  },
  "data_path": "<BASE_DIR>/data/ALBEF_dataset/combined_dataset_train.h5",
  "neg_data_path": "<BASE_DIR>/data/Optical_Negative_dataset/ELASTICC2_negative_dataset.h5",
  "neg_group": "ELASTICC2/optical_data",
  "num_workers": 4,
  "cache_in_memory": true,
  "tunable_params": [
    "lr",
    "gallery_loss_weight",
    "itc_weight",
    "cls_weight",
    "fusion_physical_weight",
    "encoder_lr_ratio",
    "stage_itc_epochs",
    "weight_decay"
  ],
  "fixed_overrides": {
    "staged_training_enable": true,
    "stage_cls_ramp_epochs": 4,
    "stage_retrieval_ramp_epochs": 4,
    "stage_joint_itc_start_weight": 0.5,
    "stage_joint_itc_end_weight": 0.25,
    "itc_extra_negative_enable": false,
    "neg_gw_guardrail_enable": true,
    "neg_gw_guardrail_recall": 0.85,
    "cls_aligned_pos_weight": 0.5,
    "cls_neg_gw_weight": 0.2,
    "cls_mismatched_weight": 0.15,
    "cls_external_neg_weight": 0.15,
    "neg_gw_pair_ratio": 0.2,
    "samples_per_gw": 4,
    "min_lc_per_gw": 2,
    "gallery_hard_neg_enable": false,
    "time_compat_weight": 0.6,
    "time_compat_tau_days": 30.0,
    "time_compat_power": 2.0,
    "time_compat_max_penalty": 4.0,
    "use_time_delta_cls_feature": true,
    "time_delta_cls_scale_days": 30.0,
    "time_delta_cls_clip": 10.0,
    "label_smoothing": 0.1,
    "fusion_spatial_weight": 1.0,
    "max_gallery_queries": 64,
    "skip_epoch_checkpoints": true,
    "warmup_epochs": 3,
    "min_lr": 0.00002
  },
  "retrain_overrides": {
    "epochs": 100,
    "steps_per_epoch": 100,
    "val_steps_per_epoch": 16,
    "early_stop_patience": 30,
    "early_stop_min_delta": 0.01,
    "neg_gw_guardrail_recall": 0.85,
    "skip_epoch_checkpoints": false
  },
  "search_space": {
    "lr": {
      "type": "float",
      "low": 0.0002,
      "high": 0.001,
      "log": true
    },
    "itc_weight": {
      "type": "categorical",
      "choices": [
        0.5,
        0.75,
        1.0
      ]
    },
    "cls_weight": {
      "type": "categorical",
      "choices": [
        0.5,
        1.0,
        1.5
      ]
    },
    "fusion_physical_weight": {
      "type": "categorical",
      "choices": [
        1.0,
        1.5,
        2.0,
        2.5
      ]
    },
    "weight_decay": {
      "type": "float",
      "low": 0.005,
      "high": 0.04,
      "log": true
    },
    "gallery_loss_weight": {
      "type": "categorical",
      "choices": [
        0.5,
        0.75,
        1.0,
        1.5,
        2.0
      ]
    },
    "encoder_lr_ratio": {
      "type": "categorical",
      "choices": [
        0.05,
        0.1,
        0.2,
        0.3
      ]
    },
    "stage_itc_epochs": {
      "type": "categorical",
      "choices": [
        5,
        6,
        8
      ]
    }
  },
  "constraints": {
    "min_lr_less_than_lr": "fixed min_lr=2e-5 < lr lower bound 2e-4",
    "stage_fit": "max(stage_itc_epochs)=8 + cls ramp=4 + retrieval ramp=4 < epochs_per_trial=30",
    "guardrail": "neg_gw_guardrail_recall=0.85 and HPO min metric val_neg_gw_min_recall>=0.85"
  }
}
