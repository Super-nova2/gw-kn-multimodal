{
  "study_name": "albef_hpo_bns_nsbh_v1",
  "n_trials": 30,
  "n_startup_trials": 10,
  "epochs_per_trial": 30,
  "output_dir": "<BASE_DIR>/data/model/hpo_results_bns_nsbh",
  "base_train_config": "<BASE_DIR>/ML+GW+KN/Model/args/ALBEF_BNS_NSBH.json",
  "objective_metric": "cls_priority_auprc_auroc_r5",
  "objective_direction": "maximize",
  "objective_weights": {
    "val_auprc": 0.45,
    "val_auroc": 0.35,
    "val_recall_at_5": 0.2
  },
  "objective_min_metrics": {
    "val_recall_at_5": 0.20
  },
  "data_path": "<BASE_DIR>/data/BNS_NSBH_dataset/combined_dataset_train.h5",
  "neg_data_path": "<BASE_DIR>/data/Optical_Negative_dataset/ELASTICC2_negative_dataset.h5",
  "neg_group": "ELASTICC2/optical_data",
  "num_workers": 4,
  "best_ckpt_metric": "cls_composite_auprc_auroc",
  "cache_in_memory": true,
  "tunable_params": [
    "lr",
    "weight_decay",
    "warmup_epochs",
    "enc_dim",
    "proj_dim",
    "gw_dropout",
    "opt_dropout",
    "fusion_dropout",
    "proj_dropout",
    "feature_dropout",
    "label_smoothing",
    "itc_weight",
    "cls_weight",
    "cls_neg_weight",
    "cls_extra_neg_weight",
    "ref_shared_dim",
    "samples_per_gw",
    "cls_start_epoch",
    "semi_hard_margin"
  ],
  "fixed_overrides": {
    "semi_hard": true
  },
  "search_space": {
    "lr": {"type": "float", "low": 0.0002, "high": 0.0008, "log": true},
    "weight_decay": {"type": "float", "low": 0.005, "high": 0.05, "log": true},
    "warmup_epochs": {"type": "categorical", "choices": [2, 3, 5, 7, 10]},
    "enc_dim": {"type": "categorical", "choices": [64, 96, 128, 160]},
    "proj_dim": {"type": "categorical", "choices": [128, 192, 256, 320]},
    "gw_dropout": {"type": "float", "low": 0.05, "high": 0.25},
    "opt_dropout": {"type": "float", "low": 0.05, "high": 0.25},
    "fusion_dropout": {"type": "float", "low": 0.1, "high": 0.4},
    "proj_dropout": {"type": "float", "low": 0.0, "high": 0.2},
    "feature_dropout": {"type": "float", "low": 0.0, "high": 0.2},
    "label_smoothing": {"type": "float", "low": 0.0, "high": 0.2},
    "itc_weight": {"type": "float", "low": 1.0, "high": 3.0},
    "cls_weight": {"type": "float", "low": 0.5, "high": 1.5},
    "cls_neg_weight": {"type": "float", "low": 0.5, "high": 1.5},
    "cls_extra_neg_weight": {"type": "float", "low": 0.2, "high": 1.0},
    "ref_shared_dim": {"type": "categorical", "choices": [32, 64, 96]},
    "samples_per_gw": {"type": "categorical", "choices": [4, 6, 8]},
    "cls_start_epoch": {"type": "categorical", "choices": [5, 10, 15]},
    "semi_hard_margin": {"type": "float", "low": 0.1, "high": 0.35}
  },
  "constraints": {
    "hard_neg_start_epoch": "cls_start_epoch + 5",
    "cls_ramp_epochs": 5,
    "hard_neg_ramp_epochs": 5
  }
}
