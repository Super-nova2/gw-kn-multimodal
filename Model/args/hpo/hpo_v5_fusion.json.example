{
  "study_name": "magiks_hpo_v5_balanced_hard_gallery",
  "n_trials": 36,
  "n_startup_trials": 8,
  "epochs_per_trial": 24,
  "output_dir": "<BASE_DIR>/data/model/hpo_results_bns_nsbh_v5_balanced_hard_gallery",
  "default_train_config": "<REPO_ROOT>/Model/args/defaults/MAGIKS_BNS_NSBH_default.json",
  "base_train_config": "<REPO_ROOT>/Model/args/MAGIKS_BNS_NSBH_full.json",
  "objective_metric": "hard_gallery_macro_retrieval",
  "objective_direction": "maximize",
  "objective_weights": {
    "val_hard_gallery_macro_retrieval_score": 1.0
  },
  "data_path": "<BASE_DIR>/data/ALBEF_dataset/combined_dataset_train.h5",
  "neg_data_path": "<BASE_DIR>/data/Optical_Negative_dataset/ELASTICC2_negative_dataset.h5",
  "neg_group": "ELASTICC2/optical_data",
  "num_workers": 4,
  "cache_in_memory": true,
  "tunable_params": [
    "lr",
    "weight_decay",
    "gallery_loss_weight",
    "gallery_hard_neg_weight",
    "gallery_hard_neg_topk",
    "fusion_physical_weight",
    "fusion_spatial_weight",
    "cls_weight",
    "itc_weight",
    "balanced_model_capacity",
    "fusion_dropout",
    "proj_dropout"
  ],
  "fixed_overrides": {
    "steps_per_epoch": 500,
    "val_steps_per_epoch": 16,
    "max_gallery_queries": 64,
    "warmup_epochs": 5,
    "cls_start_epoch": 5,
    "cls_ramp_epochs": 5,
    "retrieval_start_epoch": 10,
    "gallery_loss_ramp_epochs": 5,
    "gallery_hard_neg_enable": true,
    "gallery_hard_neg_start_after_retrieval_epochs": 3,
    "gallery_hard_neg_ramp_epochs": 3,
    "time_compat_weight": 0.6,
    "time_compat_tau_days": 30.0,
    "cls_extra_neg_weight": 0.5,
    "temp_init": 0.07,
    "skip_epoch_checkpoints": true
  },
  "retrain_overrides": {
    "epochs": 100,
    "steps_per_epoch": 1000,
    "val_steps_per_epoch": 25,
    "early_stop_patience": 20,
    "early_stop_min_delta": 0.01,
    "skip_epoch_checkpoints": false
  },
  "search_space": {
    "lr": {
      "type": "float",
      "low": 0.0003,
      "high": 0.0007,
      "log": true
    },
    "weight_decay": {
      "type": "float",
      "low": 0.012,
      "high": 0.03,
      "log": true
    },
    "gallery_loss_weight": {
      "type": "categorical",
      "choices": [
        0.7,
        0.85,
        1.0
      ]
    },
    "gallery_hard_neg_weight": {
      "type": "float",
      "low": 0.25,
      "high": 0.6
    },
    "gallery_hard_neg_topk": {
      "type": "categorical",
      "choices": [
        16,
        32
      ]
    },
    "fusion_physical_weight": {
      "type": "categorical",
      "choices": [
        1.0,
        1.5,
        2.0
      ]
    },
    "fusion_spatial_weight": {
      "type": "categorical",
      "choices": [
        0.5,
        1.0,
        1.5
      ]
    },
    "cls_weight": {
      "type": "categorical",
      "choices": [
        0.5,
        1.0,
        1.5
      ]
    },
    "itc_weight": {
      "type": "categorical",
      "choices": [
        0.5,
        0.75,
        1.0
      ]
    },
    "balanced_model_capacity": {
      "type": "categorical",
      "choices": [
        "baseline",
        "wide_balanced"
      ]
    },
    "fusion_dropout": {
      "type": "categorical",
      "choices": [
        0.1,
        0.2,
        0.3
      ]
    },
    "proj_dropout": {
      "type": "categorical",
      "choices": [
        0.0,
        0.1,
        0.2
      ]
    }
  },
  "constraints": {
    "retrieval_start_epoch": "fixed at 10 to match the v4 schedule",
    "gallery_full_activation": "retrieval_start_epoch + gallery_loss_ramp_epochs - 1 < epochs_per_trial",
    "gallery_hard_neg_full_activation": "retrieval_start_epoch + gallery_hard_neg_start_after_retrieval_epochs + gallery_hard_neg_ramp_epochs - 1 < epochs_per_trial",
    "selection": "best checkpoint and HPO objective use source-balanced hard_gallery_macro_retrieval_score inherited from MAGIKS_BNS_NSBH_default.json"
  }
}
